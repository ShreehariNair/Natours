{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "bundle.js",
  "targets": {
    "default": {
      "distDir": "./public/js/"
    }
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "set NODE_ENV=production& nodemon server.js",
    "debug": "ndb server.js",
    "watch:js": "parcel watch ./public/js/index.js --dist-dir public/js",
    "build:js": "parcel build ./public/js/index.js --dist-dir public"
  },
  "author": "Jonas Schmedtmann",
  "license": "ISC",
  "dependencies": {
    "alerts": "^0.1.3",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.3",
    "pug": "^3.0.3",
    "sharp": "^0.34.2",
    "slugify": "^1.6.6",
    "stripe": "^7.0.0",
    "validator": "^13.15.15",
    "xss-clean": "^0.1.4"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "devDependencies": {
    "parcel": "^2.15.4"
  }
}
